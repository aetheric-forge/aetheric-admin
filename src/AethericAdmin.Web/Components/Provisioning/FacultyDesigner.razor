@using AethericAdmin.Web.Provisioning

<section aria-labelledby="faculty-heading">
    <p class="eyebrow">03 · Within the Campus</p>
    <h2 id="faculty-heading">Administration Faculty</h2>
    <label for="faculty-name">Faculty name</label>
    <InputText id="faculty-name" @bind-Value="Draft.FacultyName" maxlength="100" />
    <ValidationMessage For="() => Draft.FacultyName" />
    <label for="faculty-profile">Private resource profile reference <span>(optional)</span></label>
    <InputText id="faculty-profile" @bind-Value="Draft.FacultyResourceProfile" maxlength="200" />
    <p class="hint">The Faculty owns its private resource bundle. Institutions may inherit capabilities without creating another copy of those resources.</p>
</section>

<section aria-labelledby="decisions-heading">
    <p class="eyebrow">04 · Within Administration</p>
    <h2 id="decisions-heading">Decisions Institution</h2>
    <label for="decisions-name">Institution name</label>
    <InputText id="decisions-name" @bind-Value="Draft.DecisionsName" maxlength="100" />
    <ValidationMessage For="() => Draft.DecisionsName" />
    <p class="hint">Required for this University setup. The existing Decisions definition owns its draft workspace and inherits Archive, Library, Post Office, and Registrar capabilities. Their bindings will be resolved by the provisioner.</p>
</section>

<section aria-labelledby="talent-heading">
    <p class="eyebrow">05 · Optional institution</p>
    <h2 id="talent-heading">Talent</h2>
    <label class="checkbox" for="include-talent">
        <InputCheckbox id="include-talent" @bind-Value="Draft.IncludeTalent" /> Include a Talent Institution
    </label>
    @if (Draft.IncludeTalent)
    {
        <label for="talent-name">Institution name</label>
        <InputText id="talent-name" @bind-Value="Draft.TalentName" maxlength="100" />
        <ValidationMessage For="() => Draft.TalentName" />
        <p class="hint">Talent is a sibling of Decisions. Both are caused by the University request and wait for Administration; neither depends on the other.</p>
    }
    else
    {
        <p class="hint">Talent will be omitted from the envelope. You can add it to this draft when you need it.</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public UniversityDraft Draft { get; set; } = default!;
}
