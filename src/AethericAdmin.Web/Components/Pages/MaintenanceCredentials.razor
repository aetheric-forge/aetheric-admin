@page "/maintenance/credentials"
@rendermode InteractiveServer
@using AethericAdmin.Web.Maintenance.Jobs
@inject ICredentialStore CredentialStore

<PageTitle>Maintenance Credentials</PageTitle>

<main class="container py-5">
    <p class="text-uppercase">Operations Faculty</p>
    <h1>SSH credentials</h1>
    <p class="text-muted">
        Secrets are encrypted at rest and are never shown again once saved - only a name, username,
        and (for private keys) a fingerprint. <a href="/maintenance/jobs">Jobs</a> pick a
        credential by name.
    </p>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_credentials is null)
    {
        <p>Loading credentials…</p>
    }
    else if (_credentials.Count == 0)
    {
        <div class="alert alert-secondary">No credentials yet.</div>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Kind</th>
                        <th>Fingerprint</th>
                        <th>Last used</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var credential in _credentials)
                    {
                        <tr>
                            <td>@credential.Name</td>
                            <td><code>@credential.Username</code></td>
                            <td>@credential.SecretKind</td>
                            <td class="small text-muted">@(credential.Fingerprint ?? "—")</td>
                            <td class="small text-muted">@(credential.LastUsedAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(credential.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2 class="h4">Add a credential</h2>
    <EditForm Model="_form" OnValidSubmit="AddAsync" class="d-grid gap-3" style="max-width: 40rem;">
        <div>
            <label class="form-label" for="cred-name">Name</label>
            <InputText id="cred-name" class="form-control" @bind-Value="_form.Name" />
        </div>
        <div>
            <label class="form-label" for="cred-username">Username</label>
            <InputText id="cred-username" class="form-control" @bind-Value="_form.Username" />
        </div>
        <div>
            <label class="form-label" for="cred-kind">Secret type</label>
            <InputSelect id="cred-kind" class="form-select" @bind-Value="_form.SecretKind">
                <option value="@SshCredentialSecretKind.Password">Password</option>
                <option value="@SshCredentialSecretKind.PrivateKey">Private key</option>
            </InputSelect>
        </div>
        <div>
            <label class="form-label" for="cred-secret">@(_form.SecretKind == SshCredentialSecretKind.Password ? "Password" : "Private key")</label>
            <InputTextArea id="cred-secret" class="form-control" rows="6" @bind-Value="_form.Secret" />
        </div>
        @if (_form.SecretKind == SshCredentialSecretKind.PrivateKey)
        {
            <div>
                <label class="form-label" for="cred-passphrase">Passphrase (leave blank if the key isn't passphrase-protected)</label>
                <InputText id="cred-passphrase" type="password" class="form-control" @bind-Value="_form.Passphrase" />
            </div>
        }
        <div>
            <button class="btn btn-primary" type="submit">Add credential</button>
        </div>
    </EditForm>
</main>

@code {
    private IReadOnlyList<SshCredential>? _credentials;
    private CredentialForm _form = new();
    private string? _error;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task AddAsync()
    {
        _error = null;
        try
        {
            if (_form.SecretKind == SshCredentialSecretKind.Password)
            {
                await CredentialStore.AddPasswordAsync(_form.Name, _form.Username, _form.Secret);
            }
            else
            {
                await CredentialStore.AddPrivateKeyAsync(
                    _form.Name,
                    _form.Username,
                    _form.Secret,
                    string.IsNullOrWhiteSpace(_form.Passphrase) ? null : _form.Passphrase);
            }

            _form = new CredentialForm();
            await ReloadAsync();
        }
        catch (SshCredentialValidationException exception)
        {
            _error = exception.Message;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        await CredentialStore.DeleteAsync(id);
        await ReloadAsync();
    }

    private async Task ReloadAsync() => _credentials = await CredentialStore.ListAsync();

    private sealed class CredentialForm
    {
        public string Name { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public SshCredentialSecretKind SecretKind { get; set; } = SshCredentialSecretKind.Password;
        public string Secret { get; set; } = string.Empty;
        public string? Passphrase { get; set; }
    }
}
