@using AethericAdmin.Web.Provisioning
@inject RabbitMqConnections Connections

<section class="setup-card" aria-labelledby="rabbitmq-connections-heading">
    <h2 id="rabbitmq-connections-heading">RabbitMQ access</h2>
    <p>Save both connections before submitting to Operations. Credentials are encrypted when saved and excluded from the draft download.</p>
    <EditForm Model="_broker" OnValidSubmit="SaveBroker" FormName="rabbitmq-broker">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <fieldset disabled="@_saving">
            <legend>Operations broker (AMQP)</legend>
            <p>Use the broker and virtual host where the Operations worker listens, usually port 5672 or 5671 with TLS.</p>
            <label for="broker-host">Host</label><InputText id="broker-host" @bind-Value="_broker.Host" />
            <label for="broker-port">Port</label><InputNumber id="broker-port" @bind-Value="_broker.Port" />
            <label for="broker-tls"><InputCheckbox id="broker-tls" @bind-Value="_broker.Tls" /> Use TLS</label>
            <label for="broker-vhost">Virtual host</label><InputText id="broker-vhost" @bind-Value="_broker.Vhost" />
            <label for="broker-user">Username</label><InputText id="broker-user" @bind-Value="_broker.Username" autocomplete="off" />
            <label for="broker-password">Password</label><InputText id="broker-password" type="password" @bind-Value="_broker.Password" autocomplete="new-password" />
            <button type="submit">Save Operations connection</button>
        </fieldset>
    </EditForm>
    <EditForm Model="_management" OnValidSubmit="SaveManagement" FormName="rabbitmq-management">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <fieldset disabled="@_saving">
            <legend>Campus provisioning (management API)</legend>
            <p>Operations uses this administrator account to create campus virtual hosts and users, usually through port 15672.</p>
            <label for="management-url">Management API base URL</label><InputText id="management-url" type="url" @bind-Value="_management.Url" />
            <label for="management-user">Administrator username</label><InputText id="management-user" @bind-Value="_management.Username" autocomplete="off" />
            <label for="management-password">Password</label><InputText id="management-password" type="password" @bind-Value="_management.Password" autocomplete="new-password" />
            <button type="submit">Save provisioning credentials</button>
        </fieldset>
    </EditForm>
    @if (_status is not null) { <p role="status">@_status</p> }
    @if (_error is not null) { <p role="alert">@_error</p> }
</section>

@code {
    private readonly BrokerForm _broker = new();
    private readonly ManagementForm _management = new();
    private bool _saving;
    private string? _status;
    private string? _error;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var broker = await Connections.ReadBrokerAsync();
            if (broker is not null)
            {
                _broker.Host = broker.Host; _broker.Port = broker.Port; _broker.Username = broker.Username ?? "";
                _broker.Tls = broker.RabbitMq?.Scheme == "amqps"; _broker.Vhost = broker.RabbitMq?.BasePath ?? "/";
            }
            var management = await Connections.ReadManagementAsync();
            if (management is not null)
            {
                _management.Url = new UriBuilder(management.RabbitMq?.Scheme ?? "http", management.Host, management.Port, management.RabbitMq?.BasePath ?? "/").Uri.AbsoluteUri;
                _management.Username = management.Username ?? "";
            }
            if (broker is not null || management is not null)
                _status = "Saved credentials are available. Enter a password only when saving a replacement connection.";
        }
        catch { _error = "Saved RabbitMQ settings could not be read. Check the credential volume and encryption key."; }
    }
    private Task SaveBroker() => Save(async () =>
    {
        await Connections.SaveBrokerAsync(_broker.Host, _broker.Port, _broker.Tls, _broker.Vhost, _broker.Username, _broker.Password);
        _broker.Password = "";
    }, "Operations connection saved. It will be used for the next request.");
    private Task SaveManagement() => Save(async () =>
    {
        await Connections.SaveManagementAsync(_management.Url, _management.Username, _management.Password);
        _management.Password = "";
    }, "RabbitMQ provisioning credentials saved.");
    private async Task Save(Func<Task> action, string message)
    {
        if (_saving) return;
        _saving = true; _error = null; _status = null;
        try { await action(); _status = message; }
        catch (ArgumentException ex) { _error = ex.Message; }
        catch { _error = "RabbitMQ settings could not be saved. Check the credential volume and encryption key."; }
        finally { _saving = false; }
    }
    private sealed class BrokerForm
    {
        [System.ComponentModel.DataAnnotations.Required] public string Host { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Range(1, 65535)] public int Port { get; set; } = 5672;
        public bool Tls { get; set; }
        [System.ComponentModel.DataAnnotations.Required] public string Vhost { get; set; } = "/";
        [System.ComponentModel.DataAnnotations.Required] public string Username { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Password { get; set; } = "";
    }
    private sealed class ManagementForm
    {
        [System.ComponentModel.DataAnnotations.Required] public string Url { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Username { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required] public string Password { get; set; } = "";
    }
}
